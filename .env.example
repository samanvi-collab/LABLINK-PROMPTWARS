# =============================================================================
# LABLINK — Environment Configuration
# =============================================================================
# Copy to .env for local development. Never commit .env or service-account JSON.

# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
APP_VERSION=1.0.0

# Runtime Modes (allowed pairs ONLY: demo+demo OR firestore+firebase)
STORAGE_MODE=demo
AUTH_MODE=demo

# Safety flag required ONLY when deploying demo mode with NODE_ENV=production
ALLOW_DEMO_IN_PRODUCTION=false

# Security & Rate Limiting
# Comma-separated list of allowed origins in production (leave empty for same-origin/dev)
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
BOOKING_RATE_LIMIT_MAX=30

# Firebase Admin & Firestore (Required when STORAGE_MODE=firestore & AUTH_MODE=firebase)
# Uses Application Default Credentials (ADC) — never commit service account keys.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)

# Optional Firebase Emulators (for local Firestore/Auth emulator testing)
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Public Firebase Web SDK Config (Exposed via /api/public-config when set; safe public keys only)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=

# Server-Side Gemini AI (Never expose to client; injected via Secret Manager in Cloud Run)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_TIMEOUT_MS=8000
AI_RATE_LIMIT_MAX=20
AI_CACHE_TTL_MS=60000
AI_CACHE_MAX_ENTRIES=64

