{
  "name": "lablink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/src/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/server', { recursive: true }); fs.writeFileSync('dist/server/package.json', JSON.stringify({ type: 'commonjs' }, null, 2));\"",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist/server/server/src/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/security-scan.mjs",
    "provision:users": "tsx scripts/provision-users.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@google/genai": "^3.6.1",
    "@hookform/resolvers": "^7.0.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/cors": "^2.8.19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsdom": "^31.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.28.0",
    "supertest": "^7.3.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.8.3"
  }
}
